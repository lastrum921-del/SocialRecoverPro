<?xml version="1.0" encoding="utf-8"?>
<!-- No se incluye nada en las copias de Google ni en transferencias entre dispositivos:
     las preferencias contienen permisos de carpetas que no son válidos en otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
